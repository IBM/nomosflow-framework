# Local Environment Variables Template
# Copy this file to .env.local and fill in your own values.
# .env.local is listed in .gitignore and will NEVER be committed.
#
# Usage:
#   cp .env.local.example .env.local
#   # Edit .env.local with your actual keys
#   source .env.local          # before running experiments
#
# The experiment suite runs fully in simulated mode WITHOUT any keys set.
# Keys are only needed to enable live LLM tier (T5) in EXP-3 and EXP-6.

# ── LLM API keys (optional — only needed for live T5 tier) ──────────────────
# Any OpenAI-compatible endpoint is supported.
export LLM_BASE_URL=https://api.openai.com/v1
export LLM_API_KEY=your_api_key_here
export LLM_MODEL=gpt-4o-mini

# ── FRED API key (optional — only needed for live data-lake experiments) ─────
# Free key from: https://fred.stlouisfed.org/docs/api/api_key.html
export FRED_API_KEY=your_fred_api_key_here

# ── OPA endpoint (default: http://localhost:8181) ────────────────────────────
# Override if OPA runs on a different port or host.
# export OPA_URL=http://localhost:8181

# ── Experiment tuning (all optional) ─────────────────────────────────────────
# export BENCHMARK_SCALES=100,1000,10000
# export AGENT_COUNTS=1,5,10,25,50,100
# export LLM_RATES=0.0,0.05,0.1,0.2,0.5,1.0
# export RESULTS_DIR=experiments/results
# export LLM_VALIDATION_ENABLED=false
