{
  "title": "Tier Performance Benchmark",
  "description": "Real-time metrics from benchmarks/tier_performance_benchmark.py — APL, CMF, OPA, LLM, SQLite and S3 latencies across 100 / 1k / 10k / 100k request scale runs.",
  "tags": ["benchmark", "compliance", "tiers", "performance"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "uid": "tier-benchmark",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [

    {
      "id": 1,
      "title": "Throughput (req/s)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "benchmark_throughput_rps",
          "legendFormat": "scale={{scale}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"tooltip": {"mode": "multi"}}
    },

    {
      "id": 2,
      "title": "Run Progress (%)",
      "type": "gauge",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "max(benchmark_progress_pct)",
          "legendFormat": "progress",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue",  "value": null},
              {"color": "green", "value": 100}
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "title": "Active Scale",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "benchmark_active_scale",
          "legendFormat": "scale",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "purple", "value": null}]
          }
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },

    {
      "id": 4,
      "title": "Request Rate by Decision",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(benchmark_requests_total[30s])",
          "legendFormat": "{{decision}} (scale={{scale}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*DENIED.*"},
           "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
          {"matcher": {"id": "byRegexp", "options": ".*APPROVED.*"},
           "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]}
        ]
      }
    },

    {
      "id": 5,
      "title": "Deny Rate (%)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(benchmark_requests_total{decision='DENIED'}[30s]) / rate(benchmark_requests_total[30s]) * 100",
          "legendFormat": "deny% (scale={{scale}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      }
    },

    {
      "id": 6,
      "title": "Per-Tier Latency P50 (ms)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(benchmark_tier_latency_ms_bucket{tier='apl'}[30s]))",
          "legendFormat": "APL p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(benchmark_tier_latency_ms_bucket{tier='cmf'}[30s]))",
          "legendFormat": "CMF p50",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, rate(benchmark_tier_latency_ms_bucket{tier='opa'}[30s]))",
          "legendFormat": "OPA p50",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.50, rate(benchmark_tier_latency_ms_bucket{tier='llm'}[30s]))",
          "legendFormat": "LLM p50",
          "refId": "D"
        },
        {
          "expr": "histogram_quantile(0.50, rate(benchmark_tier_latency_ms_bucket{tier='sqlite'}[30s]))",
          "legendFormat": "SQLite p50",
          "refId": "E"
        },
        {
          "expr": "histogram_quantile(0.50, rate(benchmark_tier_latency_ms_bucket{tier='total'}[30s]))",
          "legendFormat": "TOTAL p50",
          "refId": "F"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 5}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "TOTAL p50"},
           "properties": [
             {"id": "custom.lineWidth", "value": 3},
             {"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}
           ]},
          {"matcher": {"id": "byName", "options": "LLM p50"},
           "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]}
        ]
      }
    },

    {
      "id": 7,
      "title": "Per-Tier Latency P95 (ms)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(benchmark_tier_latency_ms_bucket{tier='apl'}[30s]))",
          "legendFormat": "APL p95",    "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(benchmark_tier_latency_ms_bucket{tier='cmf'}[30s]))",
          "legendFormat": "CMF p95",    "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, rate(benchmark_tier_latency_ms_bucket{tier='opa'}[30s]))",
          "legendFormat": "OPA p95",    "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, rate(benchmark_tier_latency_ms_bucket{tier='llm'}[30s]))",
          "legendFormat": "LLM p95",    "refId": "D"
        },
        {
          "expr": "histogram_quantile(0.95, rate(benchmark_tier_latency_ms_bucket{tier='sqlite'}[30s]))",
          "legendFormat": "SQLite p95", "refId": "E"
        },
        {
          "expr": "histogram_quantile(0.95, rate(benchmark_tier_latency_ms_bucket{tier='total'}[30s]))",
          "legendFormat": "TOTAL p95",  "refId": "F"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 5}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "TOTAL p95"},
           "properties": [
             {"id": "custom.lineWidth", "value": 3},
             {"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}
           ]}
        ]
      }
    },

    {
      "id": 8,
      "title": "LLM Invocations Rate",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 30, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(benchmark_llm_invocations_total[30s])",
          "legendFormat": "LLM calls/s  cb={{cb_tripped}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "bars", "fillOpacity": 60}
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*cb=True.*"},
           "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
          {"matcher": {"id": "byRegexp", "options": ".*cb=False.*"},
           "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]}
        ]
      }
    },

    {
      "id": 9,
      "title": "LLM Circuit Breaker",
      "type": "stat",
      "gridPos": {"x": 12, "y": 30, "w": 6, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "benchmark_llm_circuit_breaker_open",
          "legendFormat": "circuit",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "CLOSED", "color": "green"}}},
            {"type": "value", "options": {"1": {"text": "OPEN (rate-limited)", "color": "red"}}}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red",   "value": 1}
            ]
          }
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },

    {
      "id": 10,
      "title": "Total Requests Processed",
      "type": "stat",
      "gridPos": {"x": 18, "y": 30, "w": 6, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(benchmark_requests_total)",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}]
          }
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}
    },

    {
      "id": 11,
      "title": "Latency Heatmap — Total Pipeline (ms)",
      "type": "heatmap",
      "gridPos": {"x": 0, "y": 37, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(benchmark_tier_latency_ms_bucket{tier='total'}[30s])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "color": {"scheme": "Oranges", "mode": "scheme"},
        "yAxis": {"unit": "ms"}
      }
    }

  ],

  "templating": {"list": []},
  "annotations": {"list": []},
  "__inputs": [],
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ]
}
